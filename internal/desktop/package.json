{
  "name": "@uno/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "uno's desktop client: an Electron shell over @uno/grid.",
  "type": "module",
  "main": "out/main/index.cjs",
  "imports": {
    "#document": "@uno/grid/document",
    "#engine": "@uno/grid/engine",
    "#formula": "@uno/grid/formula",
    "#go": "@uno/grid/go",
    "#ingest": "@uno/grid/ingest",
    "#library": "@uno/grid/library",
    "#notation": "@uno/grid/notation",
    "#num": "@uno/grid/num",
    "#pattern": "@uno/grid/pattern",
    "#plugin": "@uno/grid/plugin",
    "#program": "@uno/grid/program",
    "#said": "@uno/grid/said",
    "#sheet": "@uno/grid/sheet",
    "#store": "@uno/grid/store",
    "#store/*": "@uno/grid/store/*",
    "#engine/*": "./src/engine/*.ts",
    "#main/*": "./src/main/*.ts",
    "#paraglide/*": "./src/paraglide/*.js",
    "#renderer/grid": "./src/renderer/grid/index.ts",
    "#renderer/input": "./src/renderer/input/index.ts",
    "#renderer/base.css": "./src/renderer/base.css",
    "#renderer/*": "./src/renderer/*.ts",
    "#shared/*": "./src/shared/*.ts",
    "#scripts/*": "./scripts/*.js",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    "./renderer/*": "./src/renderer/*",
    "./shared/*": "./src/shared/*",
    "./scripts/*": "./scripts/*",
    "./index.html": "./index.html"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "electron .",
    "smoke": "node scripts/build.js && node scripts/smoke.js",
    "preview": "node scripts/build.js && node scripts/preview.js",
    "test": "vp test",
    "check": "node scripts/messages.js && vp check"
  },
  "dependencies": {
    "@uno/grid": "workspace:*"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@types/node": "^26.1.1",
    "electron": "^44.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
