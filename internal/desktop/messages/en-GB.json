    {
      "declarations": [
        "input count",
        "input name",
        "local plural = count: plural",
        "local n = count: number"
      ],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{name} has {n} edit · × again to remove it",
        "plural=other": "{name} has {n} edits · × again to remove it"
      }
    }
