{
  "name": "@uno/grid",
  "version": "0.0.0",
  "description": "uno's core, in TypeScript: sheets, formulas, the transform language and the .uno container.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flacyak/uno.git",
    "directory": "internal/grid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#never": "./src/never.ts",
    "#document": "./src/document/index.ts",
    "#document/*": "./src/document/*.ts",
    "#engine": "./src/engine/index.ts",
    "#engine/*": "./src/engine/*.ts",
    "#formula": "./src/formula/index.ts",
    "#formula/*": "./src/formula/*.ts",
    "#go": "./src/go/index.ts",
    "#go/*": "./src/go/*.ts",
    "#ingest": "./src/ingest/index.ts",
    "#ingest/*": "./src/ingest/*.ts",
    "#library": "./src/library/index.ts",
    "#library/*": "./src/library/*.ts",
    "#notation": "./src/notation/index.ts",
    "#notation/*": "./src/notation/*.ts",
    "#num": "./src/num/index.ts",
    "#num/*": "./src/num/*.ts",
    "#pattern": "./src/pattern/index.ts",
    "#pattern/*": "./src/pattern/*.ts",
    "#plugin": "./src/plugin/index.ts",
    "#plugin/*": "./src/plugin/*.ts",
    "#program": "./src/program/index.ts",
    "#program/*": "./src/program/*.ts",
    "#said": "./src/said/index.ts",
    "#said/*": "./src/said/*.ts",
    "#sheet": "./src/sheet/index.ts",
    "#sheet/*": "./src/sheet/*.ts",
    "#store": "./src/store/index.ts",
    "#store/*": "./src/store/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./document": "./dist/document/index.mjs",
    "./engine": "./dist/engine/index.mjs",
    "./formula": "./dist/formula/index.mjs",
    "./go": "./dist/go/index.mjs",
    "./ingest": "./dist/ingest/index.mjs",
    "./library": "./dist/library/index.mjs",
    "./notation": "./dist/notation/index.mjs",
    "./num": "./dist/num/index.mjs",
    "./pattern": "./dist/pattern/index.mjs",
    "./plugin": "./dist/plugin/index.mjs",
    "./program": "./dist/program/index.mjs",
    "./said": "./dist/said/index.mjs",
    "./sheet": "./dist/sheet/index.mjs",
    "./store": "./dist/store/index.mjs",
    "./store/node": "./dist/store/node.mjs",
    "./store/s3": "./dist/store/s3.mjs",
    "./store/sts": "./dist/store/sts.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
