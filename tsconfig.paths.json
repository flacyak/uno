{
  // The names files go by, in one map every tool reads.
  //
  // `@engine` is the grid's engine wherever it is written: in the grid, in
  // the desktop, on the server. Each package's tsconfig extends this file,
  // Vite reads it through resolve.tsconfigPaths, tsdown through the tsconfig
  // it finds, and paths.js beside it gives Node the same map for the scripts
  // that run grid source with no bundler in between.
  //
  // Every target names a file, extension and all, so the three resolvers
  // agree without probing. `@renderer/grid` and `@renderer/input` are the
  // two folders in the renderer with an index of their own.
  "compilerOptions": {
    "paths": {
      "@never": ["./grid/src/never.ts"],
      "@document": ["./grid/src/document/index.ts"],
      "@document/*": ["./grid/src/document/*.ts"],
      "@engine": ["./grid/src/engine/index.ts"],
      "@engine/*": ["./grid/src/engine/*.ts"],
      "@formula": ["./grid/src/formula/index.ts"],
      "@formula/*": ["./grid/src/formula/*.ts"],
      "@go": ["./grid/src/go/index.ts"],
      "@go/*": ["./grid/src/go/*.ts"],
      "@ingest": ["./grid/src/ingest/index.ts"],
      "@ingest/*": ["./grid/src/ingest/*.ts"],
      "@library": ["./grid/src/library/index.ts"],
      "@library/*": ["./grid/src/library/*.ts"],
      "@notation": ["./grid/src/notation/index.ts"],
      "@notation/*": ["./grid/src/notation/*.ts"],
      "@num": ["./grid/src/num/index.ts"],
      "@num/*": ["./grid/src/num/*.ts"],
      "@pattern": ["./grid/src/pattern/index.ts"],
      "@pattern/*": ["./grid/src/pattern/*.ts"],
      "@plugin": ["./grid/src/plugin/index.ts"],
      "@plugin/*": ["./grid/src/plugin/*.ts"],
      "@program": ["./grid/src/program/index.ts"],
      "@program/*": ["./grid/src/program/*.ts"],
      "@said": ["./grid/src/said/index.ts"],
      "@said/*": ["./grid/src/said/*.ts"],
      "@sheet": ["./grid/src/sheet/index.ts"],
      "@sheet/*": ["./grid/src/sheet/*.ts"],
      "@store": ["./grid/src/store/index.ts"],
      "@store/*": ["./grid/src/store/*.ts"],
      "@grid-tests/*": ["./grid/tests/*.ts"],
      "@desktop-engine/*": ["./apps/desktop/src/engine/*.ts"],
      "@main/*": ["./apps/desktop/src/main/*.ts"],
      "@paraglide/*": ["./apps/desktop/src/paraglide/*.js"],
      "@renderer/grid": ["./apps/desktop/src/renderer/grid/index.ts"],
      "@renderer/input": ["./apps/desktop/src/renderer/input/index.ts"],
      "@renderer/*": ["./apps/desktop/src/renderer/*.ts"],
      "@shared/*": ["./apps/desktop/src/shared/*.ts"],
      "@scripts/*": ["./apps/desktop/scripts/*.js"],
      "@desktop-tests/*": ["./apps/desktop/tests/*.ts"]
    }
  }
}
