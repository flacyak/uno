<?xml version="1.0" encoding="UTF-8"?>
<!--
  The .uno type, for the shared MIME database. Installed into
  ~/.local/share/mime/packages and compiled by update-mime-database.

  It is declared a subclass of application/zip because that is what it is: a
  file manager that knows nothing about uno can still tell you it is an archive,
  and an archive tool can still open it. That is the same promise the format
  makes by being a zip at all.
-->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.uno.workspace+zip">
    <comment>uno workspace</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.uno"/>

    <!--
      A .uno renamed or saved without its extension is still recognised: every
      container written by uno begins with a zip local file header whose first
      entry is uno.json, and a local header is 30 bytes before the name it
      carries. This is a bonus rather than the mechanism — the glob is what
      normally matches — so a future format that writes its entries in another
      order costs detection of extension-less files and nothing else.
    -->
    <magic priority="60">
      <match type="string" value="PK\003\004" offset="0">
        <match type="string" value="uno.json" offset="30"/>
      </match>
    </magic>

    <!-- No icon ships with uno, so borrow the one every theme already has. -->
    <generic-icon name="x-office-spreadsheet"/>
  </mime-type>
</mime-info>
