<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The .uno type, for Launch Services.

  These two keys are merged into a packaged uno.app's Info.plist by
  associate.sh. They are kept here rather than in a complete Info.plist because
  `fyne package -os darwin` creates that file and renders its own template over
  it on every run (package-darwin.go:39), so a copy of ours would last exactly
  until the next package.

  Launch Services does not notice a changed bundle immediately. That is expected:
  associate.sh nudges it with lsregister, and a rebuild of the database or a
  login is what settles it otherwise.
-->
<plist version="1.0">
<dict>

    <!-- What a .uno is. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>io.uno.workspace</string>
            <key>UTTypeDescription</key>
            <string>uno workspace</string>

            <!--
              Conforming to the zip type is the same statement the Linux
              declaration makes with <sub-class-of type="application/zip"/>: a
              .uno is an archive, and something that only knows about archives
              can still say so and still open it.
            -->
            <key>UTTypeConformsTo</key>
            <array>
                <string>com.pkware.zip-archive</string>
            </array>

            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>uno</string>
                </array>
                <!--
                  The same media type the other two platforms register. A file
                  written on one is opened on another, so the name it travels
                  under has to be the same everywhere.
                -->
                <key>public.mime-type</key>
                <array>
                    <string>application/vnd.uno.workspace+zip</string>
                </array>
            </dict>
        </dict>
    </array>

    <!-- That uno is the application which owns it. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>uno workspace</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Owner</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>io.uno.workspace</string>
            </array>
        </dict>
    </array>

</dict>
</plist>
