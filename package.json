{
  "name": "@uno/monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run --filter @uno/desktop dev",
    "start": "vp run --filter @uno/desktop start",
    "build": "vp run --filter '@uno/*' build",
    "test": "vp run --filter '@uno/*' test",
    "check": "vp run --filter '@uno/*' check",
    "smoke": "vp run --filter @uno/desktop smoke",
    "preview": "vp run --filter @uno/desktop preview",
    "package": "vp run --filter @uno/desktop package"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
