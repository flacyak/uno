            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, place) (rate(uno_engine_index_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{place}}",
          "editorMode": "code",
          "range": true
        }
      ]
    },
